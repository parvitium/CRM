# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
# Dev login is local-only. Production must omit ALLOW_DEV_LOGIN.
ALLOW_DEV_LOGIN=true

# Production auth is Cloudflare Access. Leave these empty locally unless you
# are testing JWT verification against a real team JWKS.
# AUTH_MODE=access
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=
